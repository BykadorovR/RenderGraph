#version 450
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Source { uint value; } source;
layout(set = 0, binding = 2, std430) buffer Audit { uint values[]; } audit;
layout(set = 0, binding = 3, r32ui) uniform readonly uimage2D sourceImage;
layout(push_constant) uniform Settings { uint phase; uint increment; } settings;
void main() {
  audit.values[settings.phase * 2] = source.value;
  audit.values[settings.phase * 2 + 1] = imageLoad(sourceImage, ivec2(0)).r;
}
